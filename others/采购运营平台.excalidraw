    {
      "id": "Cxa3PeOqbbDfXSb-Z0LaG",
      "type": "text",
      "x": 5294.681379138735,
      "y": 98.8399994380959,
      "width": 1722.9239501953125,
      "height": 720,
      "angle": 0,
      "strokeColor": "#1e1e1e",
